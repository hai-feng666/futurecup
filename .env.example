# 复制本文件为 .env 后填写（或直接设置系统环境变量）
#
# 后端选择：mock = 离线确定性（默认，无需 key）；openai = 任意 OpenAI 兼容网关
HARNESS_BACKEND=mock

# 以 DeepSeek 为例：
# HARNESS_BACKEND=openai
# HARNESS_BASE_URL=https://api.deepseek.com
# HARNESS_API_KEY=sk-xxxxxxxxxxxxxxxx
# HARNESS_MODEL_FAST=deepseek-chat
# HARNESS_MODEL_STRONG=deepseek-chat

# 数据库位置（trace 落库）
HARNESS_DB=runs.db

# 设为 1 时强制在首次尝试注入数字漂移，用于演示"验证抓错 → 自动返修"
# HARNESS_FORCE_FAULT=0
